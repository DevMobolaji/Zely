{
  "watch": [
    "src"
  ],
  "ext": "ts,js,json",
  "ignore": [
    "node_modules",
    "dist",
    ".git",
    "logs"
  ],
  "execMap": {
    "ts": "ts-node --transpile-only -r tsconfig-paths/register"
  },
  "signal": "SIGTERM",
  "delay": "2000",
  "legacyWatch": false,
  "env": {
    "NODE_ENV": "development"
  }
}