{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "lib": [
      "ES2020"
    ],
    "allowJs": true,
    "rootDir": "./src",
    "outDir": "dist",
    "ignoreDeprecations": "5.0",
    "baseUrl": "./src",
    "paths": {
      "@/shared/*": [
        "shared/*"
      ],
      "@/modules/*": [
        "modules/*"
      ],
      "@/events/*": [
        "events/*"
      ],
      "@/config/*": [
        "config/*"
      ],
      "@/infrastructure/*": [
        "infrastructure/*"
      ],
      "@/kafka/*": [
        "kafka/*"
      ],
      "@/graphql/*": [
        "graphql/*"
      ],
      "@/workers/*": [
        "workers/*"
      ],
      "@/test/*": [
        "test/*"
      ],
      "@/proto/*": [
        "proto/*"
      ],
      "@/generated/*": [
        "generated/*"
      ]
    },
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src",
  ]
}